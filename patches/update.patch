+    def dpa_loss(self, f, labels, domain_label, global_protos):
+        if len(global_protos) == 0:
+            return torch.tensor(0.0, device=f.device)
+        target = f.detach().clone()
+        for i in range(labels.shape[0]):
+            key = (labels[i].item(), domain_label)
+            if key in global_protos:
+                target[i, :] = global_protos[key]
+        return 1.0 - F.cosine_similarity(F.normalize(target, dim=1), F.normalize(f, dim=1), dim=1).mean()
+
+    def cpcl_loss(self, f, labels, domain_label, global_protos, temperature=0.02):
+        if len(global_protos) == 0:
+            return torch.tensor(0.0, device=f.device)
+        other_domain_protos = {k: v for k, v in global_protos.items() if k[1] != domain_label}
+        total = 0.0
+        n_valid = 0
+        for i in range(labels.shape[0]):
+            y = labels[i].item()
+            f_now = f[i].unsqueeze(0)
+            pos = [v.unsqueeze(0) for (c, d), v in other_domain_protos.items() if c == y]
+            neg = [v.unsqueeze(0) for (c, d), v in other_domain_protos.items() if c != y]
+            if len(pos) == 0 or len(neg) == 0:
+                continue
+            f_pos = torch.cat(pos, dim=0)
+            f_neg = torch.cat(neg, dim=0)
+            f_proto = torch.cat((f_pos, f_neg), dim=0)
+            sims = F.cosine_similarity(f_now, f_proto, dim=1) / temperature
+            exp_sims = torch.exp(sims)
+            sum_pos = exp_sims[: f_pos.shape[0]].sum()
+            sum_all = exp_sims.sum()
+            total = total - torch.log(sum_pos / sum_all)
+            n_valid += 1
+        if n_valid == 0:
+            return torch.tensor(0.0, device=f.device)
+        return total / labels.shape[0]
+
